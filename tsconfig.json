{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // No "node" types on purpose. This package's node half is an empty apply
    // and nothing under src/ imports a node builtin — the absence of the type
    // library is what keeps that true, rather than a comment claiming it. The
    // test config adds them back for the bench; scripts/ is outside `include`
    // and runs under tsx.
    "types": [],
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
